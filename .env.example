# Firebase web app config — Project settings → Your apps → Web app.
# These are public by design; access is controlled by firestore.rules,
# not by keeping these secret. No Storage bucket needed — Scriber runs on
# Firestore and Auth alone.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to run entirely against the local Firebase emulators.
VITE_USE_EMULATORS=false

# Server-side only (Vercel project settings, never a .env that ships).
# Needed only so screen sharing can connect on networks that won't allow a
# direct browser-to-browser connection — see "Screen sharing" in the README.
# Left unset, sharing still works wherever a direct connection is possible.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=
