{
  "manifest_version": 3,
  "name": "Scriber Exam Supervision",
  "version": "1.0.0",
  "description": "Lets a supervisor see which other tabs are open during a Scriber exam, and puts practice one click away the rest of the time.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "https://*.pracscriber.com/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scriber"
  },
  "content_scripts": [
    {
      "matches": ["https://*.pracscriber.com/*", "http://localhost:5173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
