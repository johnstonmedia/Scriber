rules_version = '2';

// Two trust domains:
//
//  1. A student's own space — users/{uid} and its papers/attempts
//     subcollections — unchanged from before: a single ownership check, not
//     readable by anyone else, including their own org's teachers or admins.
//     (An org teacher CAN see a session a student saves through org-assigned
//     work in future, but that would be a separate, explicit write — nothing
//     here grants it implicitly.)
//
//  2. Organisations — schools — with members holding one role each:
//     'student', 'teacher' or 'admin'. Role is looked up from the caller's
//     own membership document, never trusted from client-supplied data.
//
// siteAdmins/{uid} is a third, separate flag: platform-wide management
// (accounts, organisations) with no access to any student's papers or
// dictated answers. Its first entry is created manually — see README. A
// site admin is treated as an admin of every organisation — isOrgAdmin()
// and isOrgTeacher() below both fold it in — so they can step into any
// school and actually help: rosters, classes, distributed papers, settings.
// That reach stops firmly at users/{uid}/papers and /attempts above, which
// grant no site-admin access at all, on purpose.
//
// orgCreators/{email} gates who may create a NEW organisation at all — only
// a site admin, or an email a site admin has explicitly granted here, may.
// Whoever creates an org still becomes its own admin, unchanged.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSiteAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/siteAdmins/$(request.auth.uid));
    }

    // Gates *joining or creating* an organisation, not ongoing membership —
    // an already-active member's own initial join already passed this once.
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function emailDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }

    function member(orgId) {
      return get(/databases/$(database)/documents/organisations/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organisations/$(orgId)/members/$(request.auth.uid))
        && member(orgId).data.status == 'active';
    }

    function hasRole(orgId, role) {
      return isOrgMember(orgId) && member(orgId).data.role == role;
    }

    function isOrgAdmin(orgId) {
      return hasRole(orgId, 'admin') || isSiteAdmin();
    }

    function isOrgTeacher(orgId) {
      return hasRole(orgId, 'teacher') || isOrgAdmin(orgId);
    }

    // ------------------------------------------------------------ a student

    match /users/{uid} {
      // Site admins can see the account profile itself — email, name — for
      // account management, never the subcollections below: no papers, no
      // dictated answers, from anyone, ever, site admin included.
      allow read: if isOwner(uid) || isSiteAdmin();
      allow write: if isOwner(uid);

      match /papers/{paperId} {
        allow read, write: if isOwner(uid);
      }

      match /attempts/{attemptId} {
        allow read, write: if isOwner(uid);
      }
    }

    // -------------------------------------------------------- site admins

    // Existence of a doc here is the flag; nobody can grant themselves one.
    // The first is created by hand in the Firebase console (see README) —
    // after that, existing site admins can add more.
    match /siteAdmins/{uid} {
      allow read: if isOwner(uid) || isSiteAdmin();
      allow write: if isSiteAdmin();
    }

    // The shared punctuation model, and the queue that feeds it.
    //
    // The model is what every exam room reads to decide where a full stop
    // goes, so it is world-readable — it holds no student's words, only
    // tallies over a closed list of function words and pause lengths, and a
    // writer that could not fetch it would fall back to being worse for
    // everyone. Nothing in the browser may write it: contributions go through
    // api/punctuation/contribute, which checks that every word in a sample
    // came from our own drill sentences before it is queued. A rule cannot
    // perform that check — it would have to hold the sentence bank — so the
    // rule here refuses all client writes and the route, running as admin,
    // is the only way in. That is the trust boundary, stated in one line.
    match /models/{modelId} {
      allow read: if true;
      allow write: if false;
    }

    // The contribution queue. Written by the API only, and never readable
    // from a browser: a student's queued round is theirs, and there is no
    // reason for one student to be able to enumerate another's practice.
    match /punctuationContributions/{contributionId} {
      allow read, write: if false;
    }

    // A user asking for help after something failed. Write-only from their
    // side: anyone signed in can file one, nobody but a site admin can read
    // the queue back, so filing a report never exposes anything.
    match /supportReports/{reportId} {
      allow read, update, delete: if isSiteAdmin();
      allow create: if isSignedIn();
    }

    // A school asking for a demo, filled in on the public site by somebody
    // who has no account yet — so create is open to anyone, signed in or not.
    // That is only safe because it is strictly write-only from outside: the
    // shape below is the entire document, every text field has a ceiling so
    // this can't be used as free storage, a new request must start as 'new',
    // and nobody but a site admin can ever read one back. Filing a request
    // therefore reveals nothing and the queue is not browsable.
    match /demoRequests/{requestId} {
      allow read, update, delete: if isSiteAdmin();
      allow create: if request.resource.data.keys().hasOnly(
            ['organisation', 'contactName', 'email', 'role', 'students', 'message',
             'status', 'orgId', 'handledBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['organisation', 'contactName', 'email', 'status'])
        && request.resource.data.status == 'new'
        && request.resource.data.get('orgId', null) == null
        && request.resource.data.get('handledBy', null) == null
        && request.resource.data.organisation is string
        && request.resource.data.organisation.size() > 0
        && request.resource.data.organisation.size() <= 120
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() > 0
        && request.resource.data.contactName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.get('role', '') is string
        && request.resource.data.get('role', '').size() <= 120
        && request.resource.data.get('students', '') is string
        && request.resource.data.get('students', '').size() <= 60
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 1500;
    }

    // Platform-wide switches a site admin flips — currently just the
    // "coming soon" lock. Readable by anyone (signed in or not) because the
    // app has to know whether to show the holding page before it knows who
    // is looking; only a site admin can flip it.
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isSiteAdmin();
    }

    // Existence of a doc here is permission to create an organisation. Only
    // a site admin can grant or revoke it; the invited email may read their
    // own entry, so the client can show or hide the "create one" option.
    match /orgCreators/{email} {
      allow read: if isSiteAdmin()
        || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email);
      allow write: if isSiteAdmin();
    }

    // Who may open the calibration tab, which teaches the writer one
    // student's speech. Same shape as orgCreators: existence of a document is
    // the grant, only a site admin writes it, and the invited email may read
    // their own entry so the app knows whether to offer the tab.
    match /calibrationTesters/{email} {
      allow read: if isSiteAdmin()
        || (isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email);
      allow write: if isSiteAdmin();
    }

    // A domain (or subdomain) registered here lets anyone signing up with a
    // matching, verified email address join that org instantly — no request,
    // no admin approval, since the trust decision already happened when the
    // org's own admin registered the domain. Readable by any signed-in user:
    // the sign-up walkthrough has to look this up before the account has any
    // membership doc to authorise anything else with.
    match /orgDomains/{domain} {
      allow read: if isSignedIn();
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isOrgAdmin(resource.data.orgId);
    }

    // Which school owns which subdomain: stpauls.pracscriber.com. The
    // document ID *is* the slug, because a document ID is the only thing
    // Firestore makes unique across a collection — claiming a subdomain is
    // therefore a create that fails when somebody already holds it, which is
    // exactly the guarantee wanted. There is no update: a school changing
    // its subdomain releases the old one and claims the new.
    //
    // The public sign-in page resolves subdomains through the backend (which
    // uses the Admin SDK and bypasses these rules), so nothing here needs to
    // be readable before sign-in.
    match /orgSlugs/{slug} {
      allow read: if isSignedIn();
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // ---------------------------------------------- collection-group queries
    //
    // Nested match blocks (below, under organisations/{orgId}) govern get and
    // write, and any query scoped to one specific org — but NOT a
    // collectionGroup() query spanning every org at once, which is what "which
    // organisations am I in" and "which invites are addressed to me" both are.
    // Those need their own explicit rule here, matched on the field the query
    // itself filters by (not the path-bound wildcard), since Firestore can
    // only authorise a list request using conditions it can verify against
    // exactly what the query already constrains.

    match /{path=**}/members/{uid} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/invites/{email} {
      allow list: if isSignedIn()
        && request.auth.token.email != null
        && resource.data.email == request.auth.token.email.lower();
    }

    // ------------------------------------------------------- organisations

    match /organisations/{orgId} {
      // Name/settings are not sensitive on their own, and a general user
      // needs to browse organisations to request access to one.
      allow read: if isSignedIn();
      // Only a site admin, or an email a site admin has granted create
      // access to, may start a new organisation — they become its first
      // admin via the members write below, in the same client-side
      // transaction.
      // Anyone but a site admin starts on a demo, and cannot write themselves
      // a larger one on the way in — otherwise the plan rule below would only
      // be a rule about editing, and a school could set its own ceiling by
      // choosing it at creation.
      allow create: if isEmailVerified()
        && request.resource.data.createdBy == request.auth.uid
        && (isSiteAdmin()
          || (exists(/databases/$(database)/documents/orgCreators/$(request.auth.token.email.lower()))
            && request.resource.data.plan.kind == 'demo'
            && request.resource.data.plan.studentSeats == 5));
      // A school's own admin runs everything about the organisation except
      // how big it is allowed to be. The plan — how many students the school
      // is licensed for — is the one field only a site admin may write, since
      // a school that could raise its own ceiling has no ceiling. Note that
      // isOrgAdmin() folds in site admins, so the second clause is what an
      // ordinary org admin is held to.
      allow update: if isOrgAdmin(orgId)
        && (isSiteAdmin() || request.resource.data.get('plan', {}) == resource.data.get('plan', {}));
      allow delete: if isOrgAdmin(orgId);

      match /members/{uid} {
        // Teachers and admins see the roster to build classes; a student
        // sees only their own membership record. This covers get and any
        // list scoped to one org (the roster); a query spanning every org at
        // once needs the separate collection-group rule further up.
        allow read: if isOwner(uid) || isOrgTeacher(orgId);

        // An admin manages any membership directly — invites accepted by
        // hand, role changes, removals.
        allow write: if isOrgAdmin(orgId);

        // A teacher runs their own classes and knows their students' exam
        // numbers, so they may set those two things and nothing else — not
        // roles, not status, not somebody's email.
        allow update: if isOrgTeacher(orgId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['examNumber', 'classIds']);

        // Bootstrapping: whoever created the organisation may create their
        // own membership as its first admin — isOrgAdmin() can't grant this
        // itself, since no membership exists yet for anyone to check. Email
        // verification was already required to create the org in the first
        // place, so it isn't re-checked here.
        allow create: if isOwner(uid)
          && request.resource.data.role == 'admin'
          && get(/databases/$(database)/documents/organisations/$(orgId)).data.createdBy == request.auth.uid;

        // Accepting an invite: a user may create their OWN membership, but
        // only matching a pending invite addressed to their account email,
        // and only with the role that invite actually grants — never a role
        // of their own choosing.
        allow create: if isOwner(uid)
          && isEmailVerified()
          && exists(/databases/$(database)/documents/organisations/$(orgId)/invites/$(request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/organisations/$(orgId)/invites/$(request.auth.token.email.lower())).data.status == 'pending'
          && request.resource.data.role == get(/databases/$(database)/documents/organisations/$(orgId)/invites/$(request.auth.token.email.lower())).data.role
          // Including 'admin': the role comes from an invite only an existing
          // admin could issue, and is pinned to it above, so accepting an
          // admin invite grants nothing the inviter couldn't already write
          // directly. Excluding it only broke handing a school its own
          // organisation — which is exactly how a demo starts.
          && request.resource.data.role in ['student', 'teacher', 'admin']
          && request.resource.data.status == 'active'
          // An exam number identifies a paper without naming its author, so a
          // student setting their own would defeat it. They may only carry
          // across the number the inviting teacher already put on the invite.
          && request.resource.data.get('examNumber', null)
             == get(/databases/$(database)/documents/organisations/$(orgId)/invites/$(request.auth.token.email.lower())).data.get('examNumber', null);

        // Domain auto-join: a verified email whose domain is registered to
        // this org may create their own membership directly, always as a
        // student — teacher and admin still only ever come from an explicit
        // invite, never from a domain match alone.
        allow create: if isOwner(uid)
          && isEmailVerified()
          && exists(/databases/$(database)/documents/orgDomains/$(emailDomain()))
          && get(/databases/$(database)/documents/orgDomains/$(emailDomain())).data.orgId == orgId
          && request.resource.data.role == 'student'
          && request.resource.data.status == 'active'
          // Nobody arrives by domain match with an exam number of their own
          // choosing; staff assign it afterwards.
          && request.resource.data.get('examNumber', null) == null;
      }

      match /invites/{email} {
        // Only admins issue and revoke invites.
        allow read, delete: if isOrgAdmin(orgId);
        allow create, update: if isOrgAdmin(orgId)
          && request.resource.data.email == email;
        // The invited person may read their own invite by email to discover
        // it (before they have a membership doc to authorise anything else),
        // and mark it accepted as part of joining.
        allow get: if isSignedIn() && request.auth.token.email != null
          && request.auth.token.email.lower() == email;
        allow update: if isSignedIn() && request.auth.token.email != null
          && request.auth.token.email.lower() == email
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          // Nothing else about the invite may change on self-accept.
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email;
      }

      match /joinRequests/{uid} {
        allow read: if isOwner(uid) || isOrgAdmin(orgId);
        allow create: if isOwner(uid)
          && isEmailVerified()
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending';
        // The requester may withdraw their own pending request; an admin
        // approves or denies.
        allow delete: if isOwner(uid) || isOrgAdmin(orgId);
        allow update: if isOrgAdmin(orgId);
      }

      match /classes/{classId} {
        // A student sees only classes they belong to; staff see all of them.
        allow read: if isOrgTeacher(orgId)
          || (isOrgMember(orgId) && request.auth.uid in resource.data.studentIds);
        allow create: if isOrgAdmin(orgId)
          || (isOrgTeacher(orgId) && request.auth.uid in request.resource.data.teacherIds);
        allow update, delete: if isOrgAdmin(orgId)
          || (isOrgTeacher(orgId) && request.auth.uid in resource.data.teacherIds);
      }

      match /papers/{paperId} {
        // Distribution is org-wide for any active member, regardless of
        // which class a paper is tagged against — classIds drives what the
        // dashboard highlights, not who is allowed to open it.
        allow read: if isOrgMember(orgId) || isSiteAdmin();
        allow write: if isOrgTeacher(orgId);
      }

      match /tests/{testId} {
        // Readable org-wide, same convention as papers — the UI filters to
        // a student's own class. Any of the org's teachers or admins can
        // run or take over monitoring a test, same reach they already have
        // over classes and papers — it isn't locked to whoever created it.
        allow read: if isOrgMember(orgId) || isSiteAdmin();
        allow create: if isOrgTeacher(orgId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isOrgTeacher(orgId);

        match /participants/{uid} {
          // A student manages only their own progress row; the roster view
          // (readiness counts, live word counts, answer previews) is for
          // staff only — never other students.
          allow read: if isOwner(uid) || isOrgTeacher(orgId);
          // A student may write their own progress, but never the pause
          // fields — being paused is a thing done TO them by a teacher, so a
          // student's own write has to leave those exactly as they were.
          // Being marked absent is done TO a student by whoever is taking the
          // roll, the same as being paused — a student who could mark
          // themselves present would make the roll worthless.
          allow create: if isOwner(uid)
            && request.resource.data.uid == uid
            && !request.resource.data.keys().hasAny(['paused', 'pauseEndsAt', 'pausedBy', 'attendance']);
          allow update: if isOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.get('paused', false) == resource.data.get('paused', false)
            && request.resource.data.get('pauseEndsAt', null) == resource.data.get('pauseEndsAt', null)
            && request.resource.data.get('pausedBy', null) == resource.data.get('pausedBy', null)
            && request.resource.data.get('attendance', 'present') == resource.data.get('attendance', 'present');
          // Staff pause, resume and otherwise manage any participant row.
          allow write: if isOrgTeacher(orgId);

          // The screen-share handshake — a supervisor's offer, the student's
          // answer, and the network candidates each side finds. Only these
          // two parties can touch it, and none of it means anything once the
          // connection is up: the video is peer-to-peer and never passes
          // through Firestore at all. A classmate can't reach this, since
          // they aren't the owner of this participant document.
          match /viewers/{viewerUid} {
            allow read, write: if isOwner(uid) || isOrgTeacher(orgId);

            match /{candidateSet}/{candidateId} {
              allow read, write: if isOwner(uid) || isOrgTeacher(orgId);
            }
          }
        }

        // The test's own questions, snapshotted at creation. THIS is what
        // makes a test confidential: unlike the org's papers library (which
        // any member may read at any time), this document cannot be read by a
        // student until the teacher has actually started the test. Before
        // then the text never reaches their browser at all — not in memory,
        // not in a network response, so there is nothing for dev tools to
        // find. Staff can always read it, since they set the test up.
        match /secure/{docId} {
          allow read: if isOrgTeacher(orgId)
            || (isOrgMember(orgId)
              && get(/databases/$(database)/documents/organisations/$(orgId)/tests/$(testId)).data.phase in ['reading', 'working']);
          allow write: if isOrgTeacher(orgId);
        }

        // Integrity events a student's own browser reports about itself —
        // losing focus, a copy, a devtools shortcut. Append-only from the
        // student's side: they may add to their own trail, and can never
        // read it back, edit it or delete it. Staff read the whole feed.
        match /alerts/{alertId} {
          allow read: if isOrgTeacher(orgId);
          allow create: if isOrgMember(orgId) && request.resource.data.uid == request.auth.uid;
          allow update, delete: if isOrgTeacher(orgId);
        }
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
