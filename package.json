{
  "name": "scriber",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --test src/**/*.test.ts api/**/*.test.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "node scripts/rules-check.mjs",
    "e2e": "node scripts/e2e.mjs",
    "api": "tsx scripts/api-dev.mjs",
    "test:extension": "node scripts/extension-e2e.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "firebase-admin": "^14.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.10.2",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-tools": "^15.27.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "Practise dictating exam answers to a writer, under NESA exam-provision scribe rules."
}
