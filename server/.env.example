# Copy to server/.env and fill in.

# Port the API listens on.
PORT=4000

# Where the SQLite database and uploaded papers live.
DATA_DIR=data

# Random string, 32+ characters. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Origin of the web app, for CORS in development.
CLIENT_ORIGIN=http://localhost:5173

# OAuth client ID from Google Cloud Console. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=

# Largest exam paper accepted, in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400
