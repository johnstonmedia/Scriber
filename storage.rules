rules_version = '2';

// Scriber does not use Cloud Storage. Exam papers are held on the student's own
// device (see src/lib/fileStore.ts) and never uploaded, so nothing should ever
// be readable or writable here. These rules are kept, and deny everything, so
// that creating a bucket later cannot silently expose one.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
